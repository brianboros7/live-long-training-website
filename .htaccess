RewriteEngine On
DirectoryIndex index.php
ErrorDocument 404 /404.php
Options -Indexes

# Keep private folders and repo files out of reach
RewriteRule ^(includes|storage)(/|$) - [F,L]
RewriteRule ^(README\.md|router\.php|\.cpanel\.yml|\.git.*)$ - [F,L]

# Uncomment once the domain and SSL are live:
# RewriteCond %{HTTPS} off
# RewriteRule .* https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect /page.php to /page
RewriteCond %{THE_REQUEST} \s/([^.\s?]+)\.php[\s?]
RewriteRule ^ /%1 [R=301,L]

# Old audience URLs (women-25, women-45, women-50, men-60) redirect in programs.php

# Program pages: /programs/ages-55-plus -> programs.php?slug=ages-55-plus
RewriteRule ^programs/([a-z0-9-]+)/?$ programs.php?slug=$1 [L,QSA]

# Clean URLs: /about -> about.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([a-z0-9-]+)/?$ $1.php [L,QSA]
